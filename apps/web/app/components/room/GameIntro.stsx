import { GAMES, type ClientMessage, type GameId, type MatchView } from "@brick/game";
import { useEffect } from "react";
import { playSfx } from "../../lib/audio";
import { GAME_ICON } from "../../lib/icons";
import { useMusic } from "../../lib/use-music";
import { GAME_STYLE } from "../games/types";
import { Brick } from "../ui/Brick.stsx";
import { Button } from "../ui/Button.stsx";
import { Icon } from "../ui/Icon.stsx";
import { Timer } from "../ui/Timer.stsx";
import { Title } from "../ui/Title.stsx";
import { RulesSteps } from "./Rules.stsx";

/** "How to play" before each game: the rules, who's ready, and a countdown. */
export function GameIntro({ view, gameId, send }: { view: MatchView; gameId: GameId; send: (msg: ClientMessage) => void }) {
  useMusic("think");
  useEffect(() => {
    playSfx("whoosh");
  }, [gameId]);

  const game = GAMES[gameId];
  const isHost = view.you === view.hostId;
  const ready = view.you !== null && view.introReady.includes(view.you);
  const online = view.members.filter((m) => m.status === "online");

  return (
    <div className="intro" style={{ "--game": GAME_STYLE[gameId].color }}>
      <header className="hero">
        <span className="tile" aria-hidden="true">
          <Icon name={GAME_ICON[gameId]} />
        </span>
        <div className="names">
          <span className="kicker">How to play</span>
          <Title as="h1" size="lg">
            {game.title}
          </Title>
          <p className="tagline">{game.tagline}</p>
        </div>
      </header>

      <RulesSteps gameId={gameId} stagger />

      <footer className="ready-bar">
        <Timer endsAt={view.phaseEndsAt} size={64} ticks={false} />
        <ul className="who" aria-label="Who's ready">
          {online.map((m) => {
            const isReady = view.introReady.includes(m.id);
            return (
              <li key={m.id} className={isReady ? "seat ready" : "seat"} title={`${m.name}${isReady ? " is ready" : ""}`}>
                <Brick avatar={m.avatar} size="sm" mood={isReady ? "happy" : "sleepy"} />
                <span className="seat-name">{m.name}</span>
              </li>
            );
          })}
        </ul>
        <div className="buttons">
          <Button
            size="lg"
            tone={ready ? "lime" : "sun"}
            disabled={ready}
            quiet
            onClick={() => {
              playSfx("pop");
              send({ type: "ready" });
            }}
          >
            {ready ? "Ready!" : "Got it!"}
          </Button>
          {isHost ? (
            <Button tone="paper" size="sm" onClick={() => send({ type: "next" })}>
              Start now
            </Button>
          ) : null}
        </div>
      </footer>
    </div>
  );
}

<style>
  .intro { display: flex; flex-direction: column; gap: 34px; padding-top: 6px; }
  .hero { display: flex; align-items: center; gap: 22px; }
  .tile {
    width: 104px;
    height: 104px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 54px;
    background: var(--game);
    border: var(--line) solid var(--ink);
    border-radius: 28px;
    box-shadow: var(--lift), inset -10px -10px 0 rgba(0, 0, 0, 0.14);
    animation: spin-in 0.7s cubic-bezier(0.2, 1.4, 0.4, 1), wiggle 2.6s 0.7s ease-in-out infinite;
  }
  .names { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .kicker {
    align-self: flex-start;
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 999px;
    padding: 2px 12px;
  }
  .tagline { font-size: 20px; color: var(--paper); -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; }

  .ready-bar {
    display: flex;
    align-items: center;
    gap: 18px;
    background: var(--paper);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--lift);
    padding: 12px 18px;
  }
  .who { list-style: none; margin: 0; padding: 0; display: flex; gap: 12px; flex-grow: 1; overflow-x: auto; }
  .seat { display: flex; flex-direction: column; align-items: center; gap: 2px; opacity: 0.55; transition: opacity 0.3s; }
  .ready { opacity: 1; animation: hop 0.5s ease-out; }
  .seat-name { font-weight: 900; font-size: 13px; max-width: 90px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .buttons { display: flex; align-items: center; gap: 12px; }

  @keyframes spin-in { from { rotate: -200deg; scale: 0.3; } }
  @keyframes wiggle {
    0%, 100% { rotate: -5deg; }
    50% { rotate: 5deg; }
  }
  @keyframes hop { 40% { translate: 0 -10px; } }

  @media (width < 900px) {
    .hero { flex-direction: column; align-items: flex-start; }
    .tile { width: 80px; height: 80px; font-size: 40px; }
    .ready-bar { flex-wrap: wrap; }
  }
</style>

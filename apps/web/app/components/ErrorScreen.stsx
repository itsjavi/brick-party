import { Brick } from "./ui/Brick.stsx";
import { Panel } from "./ui/Panel.stsx";
import { Stage } from "./ui/Stage.stsx";
import { Title } from "./ui/Title.stsx";

export function ErrorScreen({ title, message, detail }: { title: string; message: string; detail?: string }) {
  return (
    <Stage tint="dusk">
      <main className="wrap">
        <Brick avatar={{ color: "coral", hat: "none" }} size="xl" mood="sad" tilt={-8} />
        <Title as="h1" size="lg">
          {title}
        </Title>
        <Panel pad="md" className="msg">
          <p>{message}</p>
          <a className="home" href="/">
            Back to the title screen
          </a>
        </Panel>
        {detail ? <pre className="detail">{detail}</pre> : null}
      </main>
    </Stage>
  );
}

<style>
  .wrap {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 32px 16px;
    text-align: center;
  }
  .msg { max-width: 520px; display: flex; flex-direction: column; gap: 14px; align-items: center; font-size: 20px; }
  .home { color: var(--teal-ink); font-weight: 900; }
  .detail {
    max-width: min(900px, 100%);
    overflow: auto;
    text-align: left;
    font-size: 12px;
    background: var(--paper);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 12px;
  }
</style>

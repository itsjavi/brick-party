import type { WorstFeedbackView } from "@brick/game";
import { useEffect, useRef, useState } from "react";
import { playSfx } from "../../lib/audio";
import { useCountdown } from "../../lib/clock";
import { useChangeSfx } from "../../lib/use-phase-sfx";
import { useMusic } from "../../lib/use-music";
import { GameHud } from "../room/GameHud.stsx";
import { Tomato } from "../room/Reactions.stsx";
import { Brick } from "../ui/Brick.stsx";
import { Button } from "../ui/Button.stsx";
import { seatOf, type GameProps } from "./types";

const BANNERS: Record<WorstFeedbackView["phase"], string> = {
  answer: "Answer the survey!",
  vote: "Vote for the worst!",
  results: "The people have spoken",
  done: "That's a wrap",
};

/** Renders a prompt with its `____` blank, optionally filled in. */
function Prompt({ text, fill }: { text: string; fill?: string | null }) {
  const parts = text.split("____");
  if (parts.length === 1) return <>{text}</>;
  return (
    <>
      {parts.map((part, i) => (
        <span key={i}>
          {part}
          {i < parts.length - 1 ? <span className={fill ? "blank filled" : "blank"}>{fill ? fill.replace(/\.$/, "") : " "}</span> : null}
        </span>
      ))}
    </>
  );
}

export function WorstFeedback({ view, me, players, matchScore, act, react, reactions }: GameProps<WorstFeedbackView>) {
  useMusic(view.phase === "results" || view.phase === "done" ? "reveal" : "think");
  useChangeSfx(view.phase, (p) => (p === "results" ? "reveal" : "whoosh"));

  const myPoints = me ? (view.points[me] ?? 0) : 0;
  const previous = useRef(myPoints);
  useEffect(() => {
    if (myPoints > previous.current) playSfx("point");
    previous.current = myPoints;
  }, [myPoints]);

  const [selected, setSelected] = useState<string | null>(null);
  const [mode, setMode] = useState<"cards" | "write">("cards");
  const [draft, setDraft] = useState("");
  const submitted = useRef(false);

  useEffect(() => {
    setSelected(null);
    setDraft("");
    setMode("cards");
    submitted.current = false;
  }, [view.round]);

  const canAnswer = view.phase === "answer" && view.hand !== null && view.myAnswer === null;
  const swapsLeft = view.swapsLeft ?? 0;
  const swapSelected = () => {
    if (!selected || swapsLeft <= 0 || submitted.current) return;
    act({ type: "swap", cardId: selected });
    setSelected(null);
    playSfx("whoosh");
  };
  const submitAnswer = () => {
    if (submitted.current) return;
    if (mode === "write" && draft.trim()) {
      submitted.current = true;
      act({ type: "write", text: draft.trim() });
      playSfx("pop");
    } else if (selected) {
      submitted.current = true;
      act({ type: "play", cardId: selected });
      playSfx("pop");
    }
  };

  // When time runs out, send whatever the player had picked or typed instead of a random card.
  const { seconds } = useCountdown(view.phase === "answer" ? view.endsAt : null);
  useEffect(() => {
    if (canAnswer && seconds === 0) submitAnswer();
  });

  const selectedText = view.hand?.find((c) => c.id === selected)?.text ?? null;
  const preview = canAnswer ? (mode === "write" ? draft.trim() || null : selectedText) : view.myAnswer;
  const splats = (target: string) => reactions.filter((r) => r.emoji === "tomato" && r.target === target);

  return (
    <div className="wf">
      <GameHud
        gameId="worst-feedback"
        round={`Round ${view.round + 1} of ${view.totalRounds}`}
        banner={BANNERS[view.phase]}
        endsAt={view.phase === "done" ? null : view.endsAt}
        ticks={view.phase !== "results"}
        score={matchScore + myPoints}
      />

      <section className={view.phase === "answer" ? "prompt big" : "prompt"} key={view.round}>
        <span className="kicker">Customer survey · Question {view.round + 1}</span>
        <p className="question">
          <Prompt text={view.prompt} fill={view.phase === "answer" ? preview : null} />
        </p>
      </section>

      {view.phase === "answer" && canAnswer ? (
        <section className="picker" aria-label="Your answer">
          <div className="tabs" role="tablist">
            <button type="button" role="tab" aria-selected={mode === "cards"} className={mode === "cards" ? "tab on" : "tab"} onClick={() => setMode("cards")}>
              Play a card
            </button>
            <button type="button" role="tab" aria-selected={mode === "write"} className={mode === "write" ? "tab on" : "tab"} onClick={() => setMode("write")}>
              Write your own
            </button>
          </div>
          {mode === "cards" ? (
            <div className="hand">
              {view.hand!.map((card, i) => (
                <button
                  key={card.id}
                  type="button"
                  aria-pressed={selected === card.id}
                  className={["card", selected === card.id ? "picked" : "", card.fresh ? "fresh" : ""].join(" ")}
                  style={{ rotate: `${((i * 13) % 5) - 2}deg`, animationDelay: `${i * 60}ms` }}
                  onClick={() => {
                    playSfx("click");
                    setSelected(card.id);
                  }}
                  onDoubleClick={() => {
                    setSelected(card.id);
                    if (!submitted.current) {
                      submitted.current = true;
                      act({ type: "play", cardId: card.id });
                      playSfx("pop");
                    }
                  }}
                >
                  {card.fresh ? <span className="new-tag">New</span> : null}
                  {card.text}
                </button>
              ))}
            </div>
          ) : (
            <label className="write">
              <span className="sr-only">Your answer</span>
              <textarea
                className="textarea"
                maxLength={140}
                rows={3}
                value={draft}
                autoFocus
                placeholder="Something savage, but HR-safe..."
                onChange={(e) => setDraft(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    submitAnswer();
                  }
                }}
              />
              <span className="counter">{140 - draft.length}</span>
            </label>
          )}
          <div className="answer-buttons">
            <Button size="lg" onClick={submitAnswer} disabled={mode === "write" ? !draft.trim() : !selected} quiet>
              {mode === "write" ? "Submit answer" : "Play this card"}
            </Button>
            {mode === "cards" ? (
              <Button
                tone="paper"
                onClick={swapSelected}
                disabled={!selected || swapsLeft <= 0}
                title="Trade the selected card for a new one from the deck"
                quiet
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <path d="M4 9a8 8 0 0 1 14-3l2 2" />
                  <path d="M20 3v5h-5" />
                  <path d="M20 15a8 8 0 0 1-14 3l-2-2" />
                  <path d="M4 21v-5h5" />
                </svg>
                {swapsLeft > 0 ? `Swap it (${swapsLeft} left)` : "No swaps left"}
              </Button>
            ) : null}
          </div>
        </section>
      ) : null}

      {view.phase === "answer" && !canAnswer ? (
        <section className="waiting">
          {view.myAnswer ? (
            <p className="locked">
              Locked in: <b>{view.myAnswer}</b>
            </p>
          ) : (
            <p className="locked">You're watching this one. Next game you're in!</p>
          )}
          <ul className="who-done" aria-label="Who has answered">
            {players.map((p) => (
              <li key={p.id} className={view.answeredIds.includes(p.id) ? "seat done" : "seat"}>
                <Brick avatar={p.avatar} size="sm" mood={view.answeredIds.includes(p.id) ? "happy" : "sleepy"} />
                <span className="seat-name">{p.name}</span>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {view.phase === "vote" && view.ballot ? (
        <section className="ballot" aria-label="Answers">
          {view.ballot.map((b, i) => {
            const voted = view.myVote === b.answerId;
            return (
              <article key={b.answerId} className={b.mine ? "answer mine" : voted ? "answer voted" : "answer"} style={{ rotate: `${((i * 7) % 5) - 2}deg`, animationDelay: `${i * 80}ms` }}>
                <p className="answer-text">{b.text}</p>
                <div className="answer-actions">
                  {b.mine ? (
                    <span className="yours">Yours</span>
                  ) : (
                    <Button
                      size="sm"
                      tone={voted ? "lime" : "sun"}
                      quiet
                      disabled={!me}
                      aria-pressed={voted}
                      onClick={() => {
                        playSfx("vote");
                        act({ type: "vote", answerId: b.answerId });
                      }}
                    >
                      {voted ? "Your vote" : "Promote"}
                    </Button>
                  )}
                  <button type="button" className="throw" aria-label="Throw a tomato at this answer" onClick={() => react("tomato", b.answerId)}>
                    <Tomato size={22} />
                  </button>
                </div>
                {splats(b.answerId).map((s) => (
                  <span key={s.id} className="splat" style={{ left: `${10 + ((s.id * 29) % 70)}%`, top: `${10 + ((s.id * 17) % 50)}%` }} aria-hidden="true" />
                ))}
              </article>
            );
          })}
          <p className="tally">
            Votes in: {view.votedIds.length} / {players.length}
          </p>
        </section>
      ) : null}

      {(view.phase === "results" || view.phase === "done") && view.results ? (
        <section className="results" aria-label="Results">
          {view.results.map((r, i) => {
            const author = seatOf(players, r.authorId);
            return (
              <article key={r.answerId} className={i === 0 && r.voters.length ? "result winner" : "result"} style={{ animationDelay: `${i * 220}ms` }}>
                {r.unanimous ? <span className="ribbon">Unanimous! +200</span> : null}
                <p className="answer-text">{r.text}</p>
                <div className="byline">
                  {author ? <Brick avatar={author.avatar} size="xs" mood={r.voters.length ? "wow" : "sad"} /> : null}
                  <span className="by">
                    {author?.name ?? "Someone"}
                    {r.written ? <span className="note"> · wrote it</span> : r.auto ? <span className="note"> · auto-played</span> : null}
                  </span>
                  <span className="voters" aria-label={`${r.voters.length} votes`}>
                    {r.voters.map((v) => {
                      const voter = seatOf(players, v);
                      return voter ? <Brick key={v} avatar={voter.avatar} size="xs" /> : null;
                    })}
                  </span>
                  <span className="pts">+{r.points}</span>
                </div>
              </article>
            );
          })}
        </section>
      ) : null}
    </div>
  );
}

<style>
  .wf { display: flex; flex-direction: column; gap: 20px; }
  .prompt {
    background: var(--paper);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--lift);
    padding: 18px 26px 22px;
    rotate: -0.6deg;
    animation: drop 0.5s cubic-bezier(0.2, 1.5, 0.4, 1);
  }
  .kicker { font-weight: 900; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: var(--coral-ink); }
  .question { font-family: var(--font-display); font-size: 28px; line-height: 1.15; margin-top: 4px; }
  .big .question { font-size: 36px; }
  .blank {
    display: inline-block;
    min-width: 120px;
    border-bottom: 5px solid var(--ink);
    margin: 0 4px;
    transition: background 0.2s;
  }
  .filled { background: var(--sun-soft); border-radius: 8px 8px 0 0; padding: 0 8px; color: var(--teal-ink); }

  .picker { display: flex; flex-direction: column; gap: 16px; align-items: center; }
  .tabs { display: flex; gap: 6px; background: var(--paper); border: 3px solid var(--ink); border-radius: 16px; padding: 5px; }
  .tab { font-weight: 900; font-size: 16px; background: transparent; border: 3px solid transparent; border-radius: 11px; padding: 6px 16px; cursor: pointer; }
  .on { background: var(--sun); border-color: var(--ink); }
  .hand { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; width: 100%; }
  .card {
    min-height: 110px;
    text-align: left;
    font-family: var(--font-body);
    font-weight: 900;
    font-size: 21px;
    line-height: 1.2;
    color: var(--ink);
    background: var(--paper);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 0 6px 0 var(--ink);
    padding: 14px 16px;
    cursor: pointer;
    transition: transform 0.12s, background 0.12s, box-shadow 0.12s;
    animation: deal 0.4s cubic-bezier(0.2, 1.4, 0.4, 1) backwards;
  }
  .card:hover { transform: translateY(-4px); }
  .picked { background: var(--sun); transform: translateY(-8px) scale(1.03); box-shadow: 0 12px 0 var(--ink); rotate: 0deg !important; }
  .fresh { position: relative; }
  .new-tag {
    position: absolute;
    top: -12px;
    right: 12px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--coral);
    border: 3px solid var(--ink);
    border-radius: 999px;
    padding: 0 10px;
    rotate: 4deg;
    animation: pop-in 0.5s 0.3s cubic-bezier(0.2, 1.8, 0.4, 1) backwards;
  }
  .answer-buttons { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px; }
  .write { position: relative; width: min(720px, 100%); }
  .textarea {
    width: 100%;
    resize: none;
    font-weight: 900;
    font-size: 24px;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 0 6px 0 var(--ink);
    padding: 14px 16px 26px;
  }
  .textarea:focus { outline: none; box-shadow: 0 6px 0 var(--ink), 0 0 0 5px var(--sun); }
  .counter { position: absolute; right: 14px; bottom: 12px; font-size: 14px; color: var(--muted); }

  .waiting { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .locked { font-size: 22px; background: var(--paper); border: var(--line) solid var(--ink); border-radius: var(--radius); box-shadow: var(--lift-sm); padding: 10px 20px; text-align: center; }
  .who-done { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .seat { display: flex; flex-direction: column; align-items: center; gap: 4px; opacity: 0.5; transition: opacity 0.3s; }
  .done { opacity: 1; animation: hop 0.5s ease-out; }
  .seat-name { font-weight: 900; font-size: 14px; color: var(--paper); -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; }

  .ballot { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; }
  .answer, .result {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--paper);
    border: var(--line) solid var(--ink);
    border-radius: 22px;
    box-shadow: var(--lift);
    padding: 16px 20px 14px;
    animation: deal 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) backwards;
  }
  .voted { background: var(--sun); rotate: 0deg !important; }
  .mine { background: var(--mist); opacity: 0.85; }
  .answer-text { font-weight: 900; font-size: 23px; line-height: 1.2; }
  .answer-actions { display: flex; align-items: center; gap: 10px; }
  .yours { font-weight: 900; font-size: 14px; color: var(--muted); background: var(--paper); border: 3px dashed var(--ink); border-radius: 10px; padding: 4px 10px; }
  .throw {
    margin-left: auto;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 50%;
    cursor: pointer;
  }
  .throw:hover { rotate: -20deg; }
  .splat {
    position: absolute;
    width: 70px;
    height: 56px;
    background: #ff5a4e;
    border-radius: 48% 52% 40% 60% / 55% 45% 55% 45%;
    opacity: 0.85;
    pointer-events: none;
    animation: splat 2.4s ease-out forwards;
  }
  .tally { grid-column: 1 / -1; text-align: center; font-weight: 900; color: var(--paper); -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; font-size: 18px; }

  .results { display: flex; flex-direction: column; gap: 14px; }
  .winner { background: var(--sun); }
  .ribbon {
    position: absolute;
    top: 14px;
    right: -34px;
    rotate: 30deg;
    background: var(--coral);
    color: var(--paper);
    border: 3px solid var(--ink);
    font-family: var(--font-display);
    font-size: 14px;
    padding: 2px 40px;
  }
  .byline { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .by { font-weight: 900; }
  .note { color: var(--muted); font-size: 14px; }
  .voters { display: flex; gap: 2px; flex-grow: 1; justify-content: flex-end; }
  .pts { font-family: var(--font-display); font-size: 26px; color: var(--teal-ink); }

  @keyframes drop { from { translate: 0 -60px; opacity: 0; } }
  @keyframes deal { from { translate: 0 80px; opacity: 0; scale: 0.8; } }
  @keyframes hop { 40% { translate: 0 -10px; } }
  @keyframes pop-in { from { scale: 0; } }
  @keyframes splat {
    0% { scale: 0.2; }
    12% { scale: 1.2; }
    20% { scale: 1; }
    100% { opacity: 0; }
  }

  @media (width < 900px) {
    .hand, .ballot { grid-template-columns: minmax(0, 1fr); }
    .question, .big .question { font-size: 24px; }
  }
</style>

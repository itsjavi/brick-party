import { Link } from "react-router";
import { Icon } from "../ui/Icon.stsx";
import { Title } from "../ui/Title.stsx";
import { DEV_PAGES } from "./DevShell.stsx";

/** `/dev`: every dev page with what it's for. */
export function DevIndex() {
  return (
    <>
      <div className="intro">
        <Title as="h1" size="lg">
          Dev sandboxes
        </Title>
        <p className="lede">Try the editors, fighters and UI pieces without starting a game. Local development only: these pages are not on the live site, and nothing here is sent to a server.</p>
      </div>
      <ul className="list">
        {DEV_PAGES.map((p) => (
          <li key={p.to}>
            <Link to={p.to} className="card">
              <span className="icon">
                <Icon name={p.icon} />
              </span>
              <span className="text">
                <span className="name">{p.name}</span>
                <span className="path">{p.to}</span>
                <span className="what">{p.text}</span>
              </span>
            </Link>
          </li>
        ))}
      </ul>
    </>
  );
}

<style>
  .intro { display: flex; flex-direction: column; gap: 10px; }
  .lede { font-weight: 800; font-size: 17px; color: var(--paper); max-width: 720px; text-shadow: 0 2px 0 rgba(27, 31, 59, 0.35); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    background: var(--paper);
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--lift);
    padding: 16px 18px;
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }
  .card:hover { transform: translateY(-2px); box-shadow: 0 10px 0 var(--ink); }
  .card:active { transform: translateY(5px); box-shadow: 0 2px 0 var(--ink); }
  .icon { font-size: 34px; line-height: 1; background: var(--mist); border: 3px solid var(--ink); border-radius: var(--radius-sm); padding: 8px; }
  .text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-family: var(--font-display); font-size: 24px; }
  .path { font-weight: 900; font-size: 13px; color: var(--teal-ink); }
  .what { font-weight: 700; font-size: 15px; color: var(--muted); }
</style>

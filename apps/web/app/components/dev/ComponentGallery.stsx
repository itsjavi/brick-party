const MOODS: BrickMood[] = ["happy", "wow", "sad", "sleepy", "sly"];
const SIZES = ["xs", "sm", "md", "lg", "xl"] as const;
const BUTTON_TONES: ButtonTone[] = ["sun", "paper", "teal", "coral", "grape", "lime"];
const BUTTON_SIZES = ["sm", "md", "lg", "xl"] as const;
const PANEL_TONES = ["paper", "mist", "sun", "teal", "coral", "grape", "lime"] as const;
const TITLE_TONES = ["paper", "sun", "coral", "teal", "ink"] as const;
const TITLE_SIZES = ["sm", "md", "lg", "xl"] as const;

const SECTIONS = [
  ["bricks", "Bricks"],
  ["icons", "Icons"],
  ["buttons", "Buttons"],
  ["panels", "Panels"],
  ["titles", "Titles"],
  ["timers", "Timers"],
  ["fields", "Fields and links"],
  ["selects", "Selects"],
  ["audio", "Audio controls"],
  ["huds", "Game HUDs"],
  ["rules", "Rules and title cards"],
  ["reactions", "Reactions"],
  ["pieces", "Game pieces"],
  ["builder", "Brick builder"],
  ["showcase", "Games showcase"],
] as const;

/** `/dev/components`: the shared UI pieces with their variants, none of which need a room. */
export function ComponentGallery() {
  return (
    <>
      <div className="head">
        <Title as="h1" size="md">
          Components
        </Title>
        <nav className="toc" aria-label="Sections">
          {SECTIONS.map(([id, name]) => (
            <a key={id} href={`#${id}`} className="toc-link">
              {name}
            </a>
          ))}
        </nav>
      </div>
      <BrickSection />
      <IconSection />
      <Section id="buttons" title="Button" note="ui/Button.stsx: tone × size, plus disabled. Plays the click sound unless quiet.">
        <div className="stack">
          {BUTTON_SIZES.map((size) => (
            <div key={size} className="wrap">
              {BUTTON_TONES.map((tone) => (
                <Button key={tone} tone={tone} size={size}>
                  {tone} {size}
                </Button>
              ))}
            </div>
          ))}
          <div className="wrap">
            <Button disabled>Disabled</Button>
            <Button tone="teal" quiet>
              Quiet (no click)
            </Button>
          </div>
        </div>
      </Section>
      <Section id="panels" title="Panel" note="ui/Panel.stsx: tone, pad (sm, md, lg) and tilt.">
        <div className="grid">
          {PANEL_TONES.map((tone) => (
            <Panel key={tone} tone={tone} pad="sm">
              <b>{tone}</b>, pad sm
            </Panel>
          ))}
          <Panel pad="md">pad md</Panel>
          <Panel pad="lg">pad lg</Panel>
          <Panel pad="md" tilt={-2} tone="sun">
            tilt -2
          </Panel>
        </div>
      </Section>
      <Section id="titles" title="Title" note="ui/Title.stsx: size × tone.">
        <div className="stack">
          {TITLE_SIZES.map((size) => (
            <div key={size} className="wrap">
              {TITLE_TONES.map((tone) => (
                <Title key={tone} as="p" size={size} tone={tone}>
                  {size === "xl" ? tone : `${tone} ${size}`}
                </Title>
              ))}
            </div>
          ))}
        </div>
      </Section>
      <TimerSection />
      <Section id="fields" title="Field and LinkButton" note="ui/Field.stsx (with a hint or an error) and ui/LinkButton.stsx.">
        <div className="grid">
          <Field label="Nickname" placeholder="Your name here" />
          <Field label="With a hint" hint="Up to 20 characters" defaultValue="Brickface" />
          <Field label="With an error" error="That one's taken" defaultValue="Bricky" />
        </div>
        <div className="wrap">
          <LinkButton to="/dev">LinkButton to /dev</LinkButton>
          <LinkButton to="/dev/draw">To /dev/draw</LinkButton>
        </div>
      </Section>
      <SelectSection />
      <Section id="audio" title="AudioControls and MuteButton" note="ui/AudioControls.stsx: the real settings, so changes here stick.">
        <div className="wrap">
          <AudioControls />
          <MuteButton />
        </div>
      </Section>
      <HudSection />
      <RulesSection />
      <ReactionSection />
      <PiecesSection />
      <Section id="builder" title="BrickBuilder" note="home/BrickBuilder.stsx: the avatar picker from the title screen and the profile. Not in a form here, so it saves nothing.">
        <BrickBuilder defaultNickname="Dev brick" />
      </Section>
      <Section id="showcase" title="GamesShowcase" note="home/GamesShowcase.stsx: how a party works, and every game with its rules.">
        <details className="more">
          <summary>Show it (it's long)</summary>
          <GamesShowcase />
        </details>
      </Section>
    </>
  );
}

/** The Toybox select with previews, and a plain one with text only. */
function SelectSection() {
  const [hat, setHat] = useState<(typeof AVATAR_HATS)[number]>("crown");
  const [spice, setSpice] = useState<"mild" | "spicy">("mild");
  return (
    <Section id="selects" title="Select" note="ui/Select.stsx on Base UI's Select: options as tiles with previews, keyboard and screen-reader friendly, and with `name` it submits with a form.">
      <div className="grid">
        <Select
          label="Hat, with previews"
          value={hat}
          columns={4}
          onChange={setHat}
          options={AVATAR_HATS.map((h) => ({ value: h, label: HAT_LABELS[h], preview: <Brick avatar={{ color: "teal", hat: h, face: "classic", shape: "brick" }} size="xs" /> }))}
        />
        <Select
          label="Text only"
          value={spice}
          columns={1}
          onChange={setSpice}
          options={[
            { value: "mild", label: "Mild" },
            { value: "spicy", label: "Spicy" },
          ]}
        />
      </div>
    </Section>
  );
}

function Section({ id, title, note, children }: { id: string; title: string; note: string; children: ReactNode }) {
  return (
    <Panel pad="sm" className="section" id={id}>
      <h2 className="section-title">{title}</h2>
      <p className="note">{note}</p>
      {children}
    </Panel>
  );
}

const ICON_SIZES = [16, 24, 40, 64] as const;
const ICON_BACKS = [["paper", "#ffffff"], ["mist", "#e6f7ff"], ["sky", "#3aaefc"], ...GAME_IDS.map((id) => [id, GAME_STYLE[id].color])] as const;

function IconSection() {
  const [size, setSize] = useState<(typeof ICON_SIZES)[number]>(40);
  const [back, setBack] = useState<string>("paper");
  const color = ICON_BACKS.find(([id]) => id === back)![1];
  const names = Object.keys(ICONS) as IconName[];
  const canvas = useRef<HTMLCanvasElement>(null);
  useEffect(() => {
    const el = canvas.current;
    if (!el) return;
    const per = Math.max(1, Math.floor(el.clientWidth / (size + 16)));
    const ratio = window.devicePixelRatio || 1;
    el.width = el.clientWidth * ratio;
    el.height = Math.ceil(names.length / per) * (size + 16) * ratio;
    el.style.height = `${el.height / ratio}px`;
    const ctx = el.getContext("2d")!;
    ctx.scale(ratio, ratio);
    names.forEach((name, i) => drawIcon(ctx, name, (i % per) * (size + 16) + size / 2 + 8, Math.floor(i / per) * (size + 16) + size / 2 + 8, size));
  }, [size, names]);
  return (
    <Section id="icons" title="Icon" note="ui/Icon.stsx draws lib/icons.ts as inline SVG; the canvas below draws the same art with drawIcon, as the fight games do.">
      <Choice label="Size" value={String(size)} options={ICON_SIZES.map((s) => ({ id: String(s), name: `${s}px` }))} onChange={(s) => setSize(Number(s) as (typeof ICON_SIZES)[number])} />
      <Choice label="Background" value={back} options={ICON_BACKS.map(([id]) => ({ id, name: id }))} onChange={setBack} />
      <div className="icons" style={{ background: color }}>
        {names.map((name) => (
          <figure key={name} className="icon-cell" title={name}>
            <Icon name={name} size={size} />
            <figcaption>{name}</figcaption>
          </figure>
        ))}
      </div>
      <canvas ref={canvas} className="icon-canvas" style={{ background: color }} />
    </Section>
  );
}

function BrickSection() {
  const [size, setSize] = useState<(typeof SIZES)[number]>("md");
  const [mood, setMood] = useState<BrickMood>("happy");
  const [bounce, setBounce] = useState(false);
  const tag = (text: string) => <span className="tag">{text}</span>;
  return (
    <Section id="bricks" title="Brick" note="ui/Brick.stsx: every colour, hat, face, shape and mood. The size, mood and bounce apply to every brick below.">
      <div className="wrap">
        <Choice label="Size" value={size} options={SIZES.map((id) => ({ id, name: id }))} onChange={setSize} />
        <Choice label="Mood" value={mood} options={MOODS.map((id) => ({ id, name: id }))} onChange={setMood} />
        <label className="check">
          <input type="checkbox" checked={bounce} onChange={(e) => setBounce(e.target.checked)} /> Bounce
        </label>
      </div>
      <h3 className="sub">Colours</h3>
      <div className="row">
        {AVATAR_COLORS.map((color) => (
          <figure key={color} className="cell">
            <Brick avatar={{ color, hat: "none" }} size={size} mood={mood} bounce={bounce} />
            {tag(color)}
          </figure>
        ))}
      </div>
      <h3 className="sub">Hats</h3>
      <div className="row">
        {AVATAR_HATS.map((hat) => (
          <figure key={hat} className="cell">
            <Brick avatar={{ color: "teal", hat }} size={size} mood={mood} bounce={bounce} />
            {tag(HAT_LABELS[hat])}
          </figure>
        ))}
      </div>
      <h3 className="sub">Faces</h3>
      <div className="row">
        {AVATAR_FACES.map((face) => (
          <figure key={face} className="cell">
            <Brick avatar={{ color: "sun", hat: "none", face }} size={size} mood={mood} bounce={bounce} />
            {tag(FACE_LABELS[face])}
          </figure>
        ))}
      </div>
      <h3 className="sub">Shapes</h3>
      <div className="row">
        {AVATAR_SHAPES.map((shape) => (
          <figure key={shape} className="cell">
            <Brick avatar={{ color: "grape", hat: "none", shape }} size={size} mood={mood} bounce={bounce} />
            {tag(SHAPE_LABELS[shape])}
          </figure>
        ))}
      </div>
      <h3 className="sub">Moods and sizes</h3>
      <div className="row">
        {MOODS.map((m) => (
          <figure key={m} className="cell">
            <Brick avatar={{ color: "coral", hat: "party", face: "classic" }} size={size} mood={m} bounce={bounce} />
            {tag(m)}
          </figure>
        ))}
        {SIZES.map((s) => (
          <figure key={s} className="cell">
            <Brick avatar={{ color: "lime", hat: "crown", face: "glasses", shape: "round" }} size={s} mood={mood} tilt={-6} />
            {tag(`${s}, tilt -6`)}
          </figure>
        ))}
      </div>
    </Section>
  );
}

/** A deadline `seconds` from now, set after the first render so the server's and the browser's pages agree. */
function useDeadline(seconds: number, restart: number): number | null {
  const [endsAt, setEndsAt] = useState<number | null>(null);
  useEffect(() => setEndsAt(Date.now() + seconds * 1000), [seconds, restart]);
  return endsAt;
}

function TimerSection() {
  const [restart, setRestart] = useState(0);
  const [ticks, setTicks] = useState(false);
  const long = useDeadline(30, restart);
  const short = useDeadline(7, restart);
  return (
    <Section id="timers" title="Timer" note="ui/Timer.stsx: running, in its urgent last five seconds, and stopped (no deadline).">
      <div className="wrap">
        <figure className="cell">
          <Timer endsAt={long} ticks={ticks} />
          <span className="tag">30 s</span>
        </figure>
        <figure className="cell">
          <Timer endsAt={short} ticks={ticks} />
          <span className="tag">7 s, goes urgent</span>
        </figure>
        <figure className="cell">
          <Timer endsAt={null} />
          <span className="tag">stopped</span>
        </figure>
        <figure className="cell">
          <Timer endsAt={long} size={56} ticks={false} />
          <span className="tag">size 56</span>
        </figure>
        <Button size="sm" tone="paper" onClick={() => setRestart((n) => n + 1)}>
          Restart timers
        </Button>
        <label className="check">
          <input type="checkbox" checked={ticks} onChange={(e) => setTicks(e.target.checked)} /> Tick sounds
        </label>
      </div>
    </Section>
  );
}

function HudSection() {
  const [restart, setRestart] = useState(0);
  const endsAt = useDeadline(45, restart);
  return (
    <Section id="huds" title="GameHud" note="room/GameHud.stsx for every game: its colour and title, the round, the banner, the rules button (it opens the real dialog), the timer and the score.">
      <div className="wrap">
        <Button size="sm" tone="paper" onClick={() => setRestart((n) => n + 1)}>
          Restart the clocks
        </Button>
      </div>
      <div className="huds">
        {GAME_IDS.map((id, i) => (
          <div key={id} className="hud-row">
            <GameHud gameId={id} round={`Round ${(i % 3) + 1} of 3`} banner={GAMES[id].tagline} endsAt={i % 4 === 3 ? null : endsAt} score={i * 1250} ticks={false} />
          </div>
        ))}
      </div>
    </Section>
  );
}

function RulesSection() {
  const [game, setGame] = useState<GameId>("doodle-smash");
  return (
    <Section id="rules" title="Rules, RulesButton and NextUp" note="room/Rules.stsx and room/NextUp.stsx, per game. The buttons open the real rules dialog.">
      <div className="wrap">
        {GAME_IDS.map((id) => (
          <span key={id} className="rules-pick" style={{ "--game": GAME_STYLE[id].color }}>
            <RulesButton gameId={id} label={GAMES[id].title} />
          </span>
        ))}
      </div>
      <Choice<GameId> label="Game" value={game} options={GAME_IDS.map((id) => ({ id, name: GAMES[id].title }))} onChange={setGame} />
      <div className="duo">
        <NextUp gameId={game} />
        <NextUp gameId={game} label="Compact" compact />
      </div>
      <h3 className="sub">RulesSteps</h3>
      <RulesSteps key={game} gameId={game} stagger />
    </Section>
  );
}

function ReactionSection() {
  const [last, setLast] = useState<Reaction | null>(null);
  return (
    <Section id="reactions" title="Reactions" note="room/Reactions.stsx: the reaction bar (throttled) and the tomato.">
      <div className="wrap">
        <ReactionBar onReact={setLast} />
        <Tomato size={40} />
        <span className="note">Last: {last ? REACTION_STYLE[last].label : "none yet"}</span>
      </div>
    </Section>
  );
}

function PiecesSection() {
  const [seed, setSeed] = useState(7);
  const fighter = useMemo(() => randomSmashFighter(createRng(seed).next), [seed]);
  const doodle = useMemo(() => {
    const rng = createRng(seed + 1);
    return drawShapes(randomFighterShapes(rng.next), rng.next);
  }, [seed]);
  const figure = useFigure(fighter.strokes);
  const keys = useMemo(() => new KeyState(), []);
  return (
    <Section id="pieces" title="Game pieces" note="Read-only pieces the drawing games share. The editors themselves are in /dev/draw and the fighter viewer in /dev/fighter.">
      <div className="wrap">
        <Button size="sm" tone="grape" onClick={() => setSeed((s) => s + 1)}>
          Another random fighter
        </Button>
        <span className="note">seed {seed}</span>
      </div>
      <div className="wrap top">
        <figure className="cell">
          {figure ? <FighterPreview fighter={figure} size={220} /> : null}
          <span className="tag">FighterPreview</span>
        </figure>
        <figure className="cell">
          {figure ? <FighterPreview fighter={figure} size={160} still /> : null}
          <span className="tag">FighterPreview still</span>
        </figure>
        <figure className="cell">
          <div className="frame">
            <Drawing strokes={doodle} label="A random doodle" />
          </div>
          <span className="tag">skip-logic/Drawing</span>
        </figure>
        <figure className="cell">
          <TouchPad keys={keys} />
          <span className="tag">smash/TouchPad (presses go nowhere)</span>
        </figure>
      </div>
    </Section>
  );
}

<style>
  .head { display: flex; flex-direction: column; gap: 10px; }
  .toc { display: flex; flex-wrap: wrap; gap: 6px; }
  .toc-link {
    font-weight: 900;
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .section { display: flex; flex-direction: column; gap: 10px; scroll-margin-top: 16px; min-width: 0; }
  .section-title { font-family: var(--font-display); font-weight: 400; font-size: 26px; }
  .sub { font-family: var(--font-display); font-weight: 400; font-size: 18px; margin-top: 4px; }
  .note { font-weight: 700; font-size: 14px; color: var(--muted); }
  .stack { display: flex; flex-direction: column; gap: 14px; }
  .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .wrap.top { align-items: flex-start; }
  .row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; padding: 8px; background: var(--mist); border-radius: var(--radius-sm); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 14px; align-items: start; }
  .cell { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .tag { font-weight: 900; font-size: 12px; background: var(--paper); border: 2px solid var(--ink); border-radius: 999px; padding: 0 8px; white-space: nowrap; }
  .check { display: inline-flex; align-items: center; gap: 6px; font-weight: 900; font-size: 14px; cursor: pointer; }
  .check input { width: 18px; height: 18px; accent-color: var(--teal-ink); }
  .huds { display: flex; flex-direction: column; gap: 12px; }
  .hud-row { padding: 10px; background: var(--sky); border-radius: var(--radius-sm); }
  .icons { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px; border: 3px solid var(--ink); border-radius: var(--radius-sm); }
  .icon-cell { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 64px; }
  .icon-cell figcaption { font-weight: 800; font-size: 11px; background: var(--paper); border-radius: 999px; padding: 0 6px; }
  .icon-canvas { display: block; width: 100%; border: 3px solid var(--ink); border-radius: var(--radius-sm); }
  .rules-pick { display: inline-flex; border-bottom: 5px solid var(--game); border-radius: 999px; }
  .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 14px; align-items: start; }
  .frame { width: 220px; max-width: 100%; border: 3px solid var(--ink); border-radius: var(--radius-sm); overflow: hidden; }
  .more summary { cursor: pointer; font-weight: 900; }
  .more[open] { padding: 12px; background: var(--sky); border-radius: var(--radius-sm); }
</style>

{
  "name": "@brick/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @brick/db generate && pnpm db:migrate:local && react-router dev",
    "build": "pnpm --filter @brick/db generate && react-router build",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply brick-party --remote",
    "db:migrate:local": "wrangler d1 migrations apply brick-party --local",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm --filter @brick/db generate && wrangler types && react-router typegen && stsx typegen && tsc -p ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@brick/content": "workspace:*",
    "@brick/db": "workspace:*",
    "@brick/game": "workspace:*",
    "@brick/party": "workspace:*",
    "canvas-confetti": "^1.9.4",
    "isbot": "^5.2.2",
    "jose": "^6.2.13",
    "motion": "^14.7.1",
    "partysocket": "^1.3.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@lumiose/stsx": "^0.8.1",
    "@react-router/dev": "^8.5.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  }
}
